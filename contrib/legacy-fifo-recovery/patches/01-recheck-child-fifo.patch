+    /// A guest can publish after a doorbell was handled. Recheck the node without another poke.
+    #[cfg(target_os = "linux")]
+    #[test]
+    fn published_bytes_progress_without_another_doorbell() {
+        use std::sync::mpsc;
+        use std::time::Duration;
+
+        for initially_written in [0, 2] {
+            let kit = Kit::new();
+            let (f, m) = mapped_child(&kit, 1);
+            m.ring.write(0, &[1, 2, 3, 4]);
+            m.node.write_u32(0, initially_written);
+            let reader = f.clone();
+            let (tx, rx) = mpsc::channel();
+            let thread = std::thread::spawn(move || {
+                let mut bytes = [0u8; 4];
+                let read = reader.read_bytes(&mut bytes);
+                tx.send((read, bytes)).unwrap();
+            });
+            assert!(wait_for(|| f.waiting_for_bytes.load(Ordering::SeqCst) == 1));
+            // The lock ensures the reader has entered its condition wait. Publish only;
+            // no interrupt, poke, or fabricated completion is supplied by the test.
+            {
+                let _guard = f.lock.lock();
+                m.node_ptr().store_seqcst_u32(0, 4, DeathKind::NodeNull);
+            }
+            assert!(rx.recv_timeout(Duration::from_millis(10)).is_err());
+            kit.platform
+                .virtual_clock()
+                .advance(Duration::from_millis(50));
+            let answer = rx.recv_timeout(Duration::from_secs(1));
+            // Join even on the old implementation, so the regression fails without hanging.
+            f.quiesce();
+            f.poke();
+            thread.join().unwrap();
+            assert_eq!(answer.unwrap(), (true, [1, 2, 3, 4]));
+            let Ring::Child(child) = &f.ring else {
+                panic!()
+            };
+            assert_eq!(child.read_count.load(Ordering::Relaxed), 4);
+            assert_eq!(m.node.read_u32(4), Some(0)); // publication still belongs to advance
+        }
+    }
