+    /// Seamless input crosses the image edge after clicks and releases a drag outside it.
+    #[test]
+    fn seamless_clicks_and_drags_never_capture() {
+        let mut input = Input::seamless();
+        input.focus_gained(0);
+        let at_start = at((10.0, 10.0));
+        assert!(
+            !input
+                .button_down(BUTTON_LEFT, 1_000_000_000, &at_start)
+                .capture_changed
+        );
+        assert!(!input.is_captured());
+        assert_eq!(input.pointer_confinement(at_start.image), None);
+        input.moved(&at((150.0, 10.0)));
+        input.button_up(BUTTON_LEFT, &at((150.0, 10.0)));
+        input.moved(&at((10.0, 10.0)));
+        assert_eq!(
+            input.take(),
+            vec![
+                pointer(20, 20, BUTTON_LEFT),
+                pointer(199, 20, BUTTON_LEFT),
+                pointer(199, 20, 0),
+                pointer(20, 20, 0)
+            ]
+        );
+        input.key(0x04, true, false);
+        input.focus_lost();
+        assert_eq!(
+            input.take(),
+            vec![
+                ToHost::Key(KeyEvent::down(0x04)),
+                ToHost::Key(KeyEvent::up(0x04))
+            ]
+        );
+        assert!(!input.title_suffix().contains("capture"));
+    }
+
