+///
+/// A seamless drag retains the source's button ownership, but uses the destination
+/// window's coordinates and callback when SDL's automatic drag capture names the source.
+pub(crate) fn route_seamless_drag(id: u64, kind: u32, event: &SDL_Event) -> bool {
+    let point = if kind == SDL_EVENT_MOUSE_MOTION.0 {
+        // SAFETY: the event type selects the motion member.
+        unsafe { (event.motion.x, event.motion.y) }
+    } else if kind == SDL_EVENT_MOUSE_BUTTON_UP.0 {
+        // SAFETY: the event type selects the button member.
+        unsafe { (event.button.x, event.button.y) }
+    } else {
+        return false;
+    };
+    let source =
+        shell::each_open(|s| (s.window.id() == id && s.input.0.has_buttons()).then_some(s.sdl));
+    let Some(&source) = source.first() else {
+        return false;
+    };
+    let (mut sx, mut sy) = (0, 0);
+    // SAFETY: all window access is on SDL's owning thread.
+    if !unsafe { SDL_GetWindowPosition(source, &mut sx, &mut sy) } {
+        return false;
+    }
+    let global = (
+        f64::from(sx) + f64::from(point.0),
+        f64::from(sy) + f64::from(point.1),
+    );
+    let targets = shell::each_open(|s| {
+        if s.closed {
+            return None;
+        }
+        let (mut x, mut y, mut w, mut h) = (0, 0, 0, 0);
+        // SAFETY: these are live SDL windows on SDL's thread.
+        unsafe {
+            if (SDL_GetWindowFlags(s.sdl) & (SDL_WINDOW_HIDDEN | SDL_WINDOW_MINIMIZED)).0 != 0
+                || !SDL_GetWindowPosition(s.sdl, &mut x, &mut y)
+                || !SDL_GetWindowSize(s.sdl, &mut w, &mut h)
+            {
+                return None;
+            }
+        }
+        let local = (global.0 - f64::from(x), global.1 - f64::from(y));
+        if local.0 < 0.0 || local.1 < 0.0 || local.0 >= f64::from(w) || local.1 >= f64::from(h) {
+            return None;
+        }
+        Some((
+            s.window.clone(),
+            At {
+                point: Some(local),
+                image: s.layout.image,
+                guest: s.window.mode(),
+            },
+        ))
+    });
+    // Inside the source, preserve ordinary capture behavior even if windows overlap.
+    if targets.iter().any(|(w, _)| w.id() == id) {
+        return false;
+    }
+    let Some((target, at)) = targets.first() else {
+        return false;
+    };
+    shell::with_shell(id, |source| {
+        if kind == SDL_EVENT_MOUSE_MOTION.0 {
+            source.input.0.moved(at);
+        } else {
+            // SAFETY: the remaining kind is button-up.
+            source
+                .input
+                .0
+                .button_up(input::button_bit(unsafe { event.button.button }), at);
+        }
+        source.input.flush(target);
+    });
+    true
+}
