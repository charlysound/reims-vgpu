+/// Keeps a failed switch from sending new-screen coordinates to the old screen.
+/// A release still reaches the guest at the last accepted point, so a helper
+/// failure cannot leave a mouse button down.
+fn synchronized_pointer_event(port: u64, event: input::ToHost) -> Option<input::ToHost> {
+    use std::cell::Cell;
+
+    thread_local! {
+        static LAST_POINTER: Cell<Option<input::ToHost>> = const { Cell::new(None) };
+    }
+    let input::ToHost::Pointer { at, mode, buttons } = event else {
+        return Some(event);
+    };
+    let event = if select_tablet_display(port, at, mode) {
+        event
+    } else {
+        let input::ToHost::Pointer {
+            at,
+            mode,
+            buttons: previous_buttons,
+        } = LAST_POINTER.get()?
+        else {
+            return None;
+        };
+        let buttons = buttons & previous_buttons;
+        if buttons == previous_buttons {
+            return None;
+        }
+        input::ToHost::Pointer { at, mode, buttons }
+    };
+    LAST_POINTER.set(Some(event));
+    Some(event)
+}
