+        let mut invalid = unit.clone();
+        invalid[0] = 0x44; // PPS, not SPS
+        assert!(crop_hardware_sps(&invalid, 1920, 1080).is_err());
+        invalid = unit.clone();
+        invalid[2] |= 2; // more than one sub-layer
+        assert!(crop_hardware_sps(&invalid, 1920, 1080).is_err());
+        invalid = unit;
+        invalid.push(0); // no rbsp_stop_one_bit in the final byte
+        assert!(crop_hardware_sps(&invalid, 1920, 1080).is_err());
