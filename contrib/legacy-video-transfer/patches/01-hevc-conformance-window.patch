+/// Set the display size of a hardware SPS without changing its coding
+/// syntax. Mesa 25.2.8 on Navi21 returns a 1920x1088 SPS without a
+/// conformance window for a 1920x1080 encode, even with packed headers.
+/// The hardware's other fields must survive: its slices use those fields,
+/// which need not match the SPS originally submitted to the driver.
+pub(crate) fn crop_hardware_sps(
+    unit: &[u8],
+    width: u32,
+    height: u32,
+) -> Result<Vec<u8>, Unsupported> {
+    crop_sps(unit, width, height)
+        .map_err(|error| Unsupported(format!("the hardware's HEVC conformance window: {error:?}")))
+}
+
+fn crop_sps(unit: &[u8], width: u32, height: u32) -> Result<Vec<u8>, crate::hevc::Error> {
+    use crate::hevc::Error;
+    let mut r = BitReader::new(unit);
+    if r.bits(16)? != 0x4201 {
+        return Err(Error::Unsupported("SPS NAL header"));
+    }
+    r.skip(4)?;
+    if r.bits(3)? != 0 {
+        return Err(Error::Unsupported("sub-layers"));
+    }
+    r.skip(1 + 96)?; // temporal nesting and general profile_tier_level
+    r.ue_max(15, "sps_seq_parameter_set_id")?;
+    if r.ue()? != 1 {
+        return Err(Error::Unsupported("encoder chroma format"));
+    }
+    let coded_width = r.ue()?;
+    let coded_height = r.ue()?;
+    let start = r.position();
+    let mut offsets = [0; 4]; // left, right, top, bottom, in chroma samples
+    if r.bit()? {
+        for offset in &mut offsets {
+            *offset = r.ue()?;
+        }
+    }
+    let end = r.position();
+    let padding = |coded: u32, visible: u32, origin: u32| {
+        let total = coded.checked_sub(visible)?;
+        if visible == 0 || total % 2 != 0 {
+            return None;
+        }
+        (total / 2).checked_sub(origin)
+    };
+    let right = padding(coded_width, width, offsets[0])
+        .ok_or(Error::OutOfRange("horizontal conformance window"))?;
+    let bottom = padding(coded_height, height, offsets[2])
+        .ok_or(Error::OutOfRange("vertical conformance window"))?;
+
+    // Find rbsp_stop_one_bit, excluding only its byte-alignment zeros.
+    // Copy the opaque remainder up to that bit, then align it anew: the
+    // inserted Exp-Golomb fields can change the byte boundary.
+    let rbsp: Vec<u8> = crate::h264::bits::Unescape::new(unit).collect();
+    let last = *rbsp.last().ok_or(Error::Truncated)?;
+    if last == 0 {
+        return Err(Error::OutOfRange("SPS trailing bits"));
+    }
+    let alignment = usize::try_from(last.trailing_zeros()).map_err(|_| Error::Truncated)?;
+    let stop = rbsp
+        .len()
+        .checked_mul(8)
+        .and_then(|bits| bits.checked_sub(alignment))
+        .and_then(|bits| bits.checked_sub(1))
+        .ok_or(Error::Truncated)?;
+    if end >= stop {
+        return Err(Error::Truncated);
+    }
+    if offsets[1] == right && offsets[3] == bottom {
+        return Ok(unit.to_vec());
+    }
+    offsets[1] = right;
+    offsets[3] = bottom;
+    let mut w = BitWriter::new();
+    let mut source = BitReader::new(unit);
+    source.skip(16)?;
+    for _ in 16..start {
+        w.bit(source.bit()?);
+    }
+    let cropped = offsets.iter().any(|&v| v != 0);
+    w.flag(cropped);
+    if cropped {
+        for offset in offsets {
+            w.ue(offset);
+        }
+    }
+    for _ in start..end {
+        source.bit()?;
+    }
+    for _ in end..stop {
+        w.bit(source.bit()?);
+    }
+    w.trailing_bits();
+    Ok(nal::escape(
+        unit.get(..2).ok_or(Error::Truncated)?,
+        &w.into_bytes(),
+    ))
+}
