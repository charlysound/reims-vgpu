index 0000000000000000000000000000000000000000..e78560e4c732a000e1c84c4140fbd88a8dd871ee
--- /dev/null
+++ b/crates/reims-vgpu-core/src/tasks/local/external_read.rs
@@ -0,0 +1,110 @@
+//! Local task backing coherence at the video device's CPU read boundary.
+use super::LocalTask;
+#[cfg(target_os = "linux")]
+use super::{PAGE, page_address};
+#[cfg(target_os = "linux")]
+use crate::num::ToU64;
+use crate::platform::Platform;
+use crate::platform::blit::{BlitCmd, BlitEncoder};
+use crate::platform::command::{CommandBuffer, CommandQueue};
+use crate::platform::types::CommandBufferStatus;
+use crate::raise::{OnFault, RaiseResult};
+use crate::resources::resource::Resource;
+use crate::rt::{Held, Hold};
+#[cfg(target_os = "linux")]
+use std::ops::Range;
+
+impl<P: Platform> LocalTask<P> {
+    /// Resolve task pages to the original RAM addresses also held by the IOSurface mapper.
+    #[cfg(target_os = "linux")]
+    pub(super) fn external_backing_runs(
+        &self,
+        hold: Hold<'_>,
+        page: u32,
+        length: u64,
+    ) -> RaiseResult<Vec<Range<u64>>> {
+        let Some(map) = self.device.upgrade().and_then(|d| d.memory_map()) else {
+            return Ok(Vec::new());
+        };
+        let Some(walker) = &self.walker else {
+            return Ok(Vec::new());
+        };
+        let mut runs = Vec::new();
+        let mut missing = false;
+        walker.visit_pages_in_range(
+            hold,
+            OnFault::Return,
+            page_address(page),
+            length,
+            &mut |_, page, _| {
+                let ptr = map.virtual_address_for_physical(page_address(page), PAGE);
+                if ptr.is_null() {
+                    missing = true;
+                    return Ok(false);
+                }
+                let start = ptr.addr().to_u64();
+                runs.push(start..start + PAGE);
+                Ok(true)
+            },
+        )?;
+        if missing {
+            return Ok(Vec::new());
+        }
+        runs.sort_unstable_by_key(|r| r.start);
+        let mut merged: Vec<Range<u64>> = Vec::new();
+        for run in runs {
+            if let Some(last) = merged.last_mut()
+                && run.start <= last.end
+            {
+                last.end = last.end.max(run.end);
+            } else {
+                merged.push(run)
+            }
+        }
+        Ok(merged)
+    }
+
+    /// The producer has completed before the video request. Wait for this backing's blit
+    /// before exposing the bytes; a failed copy is an error, never a stale successful read.
+    pub(super) fn external_backing_read(&self, backing: &Resource<P>) -> Result<(), String> {
+        let held = Held::new();
+        let hold = Hold::of(&held);
+        let _lock = self.base.mutex.read();
+        if !backing.needs_sync() {
+            return Ok(());
+        }
+        let result = (|| -> RaiseResult<bool> {
+            let Some(queue) = self.base.paging_queue() else {
+                return Ok(false);
+            };
+            let Some(buffer) = queue.command_buffer(OnFault::Return)? else {
+                return Ok(false);
+            };
+            let Some(encoder) = buffer.blit_encoder(OnFault::Return)? else {
+                return Ok(false);
+            };
+            let mut copied = backing.synchronize_in_encoder(hold, Some(&encoder));
+            hold.cleanup_step(
+                &mut copied,
+                encoder.encode(OnFault::Return, BlitCmd::EndEncoding),
+            )?;
+            copied?;
+            buffer.commit(OnFault::Return)?;
+            buffer.wait_until_completed(OnFault::Return)?;
+            Ok(buffer.status() == CommandBufferStatus::COMPLETED)
+        })();
+        match result {
+            Ok(true) => Ok(()),
+            Ok(false) => {
+                backing.set_is_guest_valid(false);
+                Err("IOSurface GPU writeback did not complete".to_owned())
+            }
+            Err(error) => {
+                backing.set_is_guest_valid(false);
+                let reason = error.exception().to_owned();
+                hold.land(error);
+                Err(reason)
+            }
+        }
+    }
+}
