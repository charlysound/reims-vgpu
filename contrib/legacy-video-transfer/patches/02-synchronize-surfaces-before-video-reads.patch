@@ -0,0 +1,115 @@
+//! Synchronize GPU-backed IOSurfaces before a second device reads the same guest RAM.
+//!
+//! Legacy x86 GPU backings have private host textures. Video's mapper sees their guest
+//! pages instead. A completed Metal transfer need not include an IOSurface CPU lock, so
+//! reading those pages directly can return the preceding frame (or zero). Match the
+//! reader's original host RAM runs and write back only those live backings. Registration
+//! holds neither a resource nor its task alive; no callback runs under the registry lock.
+use std::ops::Range;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Weak};
+
+use crate::platform::Platform;
+use crate::resources::resource::{Resource, TaskRef};
+use crate::sync::Mutex;
+
+trait Reader: Send + Sync {
+    fn alive(&self) -> bool;
+    fn synchronize(&self, runs: &[Range<u64>]) -> Result<bool, String>;
+}
+
+static READERS: Mutex<Vec<Arc<dyn Reader>>> = Mutex::new(Vec::new());
+static REPORTED: AtomicBool = AtomicBool::new(false);
+
+struct Backing<P: Platform> {
+    resource: Weak<Resource<P>>,
+    task: TaskRef<P>,
+    /// Serializes readers through completion, including the early validity update.
+    reading: Mutex<()>,
+    runs: Arc<Mutex<Vec<Range<u64>>>>,
+}
+
+impl<P: Platform> Reader for Backing<P> {
+    fn alive(&self) -> bool {
+        self.resource.strong_count() > 0
+    }
+
+    fn synchronize(&self, runs: &[Range<u64>]) -> Result<bool, String> {
+        let _reading = self.reading.lock();
+        let Some(resource) = self.resource.upgrade() else {
+            return Ok(false);
+        };
+        if !resource.needs_sync() || !overlap(&self.runs.lock(), runs) {
+            return Ok(false);
+        }
+        let task = self
+            .task
+            .upgrade()
+            .ok_or("IOSurface backing task ended before read")?;
+        task.synchronize_backing_for_reader(&resource)?;
+        Ok(true)
+    }
+}
+
+/// Registers a backing with original host RAM runs. Empty runs mean unsupported.
+pub(crate) fn register<P: Platform>(
+    resource: &Arc<Resource<P>>,
+    task: TaskRef<P>,
+    runs: Arc<Mutex<Vec<Range<u64>>>>,
+) {
+    if runs.lock().is_empty() {
+        return;
+    }
+    let mut readers = READERS.lock();
+    readers.retain(|r| r.alive());
+    readers.push(Arc::new(Backing {
+        resource: Arc::downgrade(resource),
+        task,
+        reading: Mutex::new(()),
+        runs,
+    }));
+}
+
+/// Complete writeback before the caller lends these bytes to another device.
+/// The caller owns the surface and orders the producer before this read.
+pub fn synchronize(runs: &[Range<u64>]) -> Result<(), String> {
+    if runs.is_empty() {
+        return Ok(());
+    }
+    let live = {
+        let mut readers = READERS.lock();
+        readers.retain(|r| r.alive());
+        readers.clone()
+    };
+    for reader in live {
+        if reader.synchronize(runs)? && !REPORTED.swap(true, Ordering::Relaxed) {
+            log::info!("IOSurface GPU backing synchronized before external device read");
+        }
+    }
+    Ok(())
+}
+
+/// Runs on each side are sorted and merged.
+fn overlap(a: &[Range<u64>], b: &[Range<u64>]) -> bool {
+    let (mut i, mut j) = (0, 0);
+    while let (Some(x), Some(y)) = (a.get(i), b.get(j)) {
+        if x.start < y.end && y.start < x.end {
+            return true;
+        }
+        if x.end <= y.end { i += 1 } else { j += 1 }
+    }
+    false
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    #[allow(clippy::single_range_in_vec_init)] // Each element is a memory run, not its bytes.
+    fn only_shared_bytes_match() {
+        assert!(overlap(&[10..20, 30..40], &[0..11]));
+        assert!(overlap(&[10..20, 30..40], &[39..50]));
+        assert!(!overlap(&[10..20, 30..40], &[20..30]));
+        assert!(!overlap(&[], &[10..20]));
+    }
+}
