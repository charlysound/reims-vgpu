diff --git a/hw/display/apple-gfx.c b/hw/display/apple-gfx.c
index 21be0f577b8bbaa098eebcc231b2cd38ffa22718..77552419215183209757e45435faefe68f8ff612 100644
--- a/hw/display/apple-gfx.c
+++ b/hw/display/apple-gfx.c
@@ -331,6 +331,46 @@ static void set_cursor_glyph(AppleGFXDisplay *d,
 /* The most wheel notches one scroll event sends the guest, on each axis. */
 #define APPLE_GFX_WHEEL_MAX_NOTCHES 256
 
+/*
+ * A tablet stops reporting downward travel at the bottom pixel. A short
+ * stream from a relative USB mouse supplies the pressure macOS uses to move
+ * its Dock to this display. End the stream on any ordinary pointer movement
+ * off the edge, a button press, or after a bounded dwell.
+ */
+static void apple_gfx_dock_pulse(void *opaque)
+{
+    AppleGFXState *s = opaque;
+
+    if (s->dock_pulses && s->dock_display && !s->input_buttons) {
+        qemu_input_queue_rel(s->dock_display->con, INPUT_AXIS_Y, 18);
+        qemu_input_event_sync();
+        if (--s->dock_pulses) {
+            timer_mod(s->dock_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 80);
+        }
+    }
+}
+
+static void apple_gfx_dock_pressure(AppleGFXDisplay *d, uint16_t x, uint16_t y,
+                                    uint16_t width, uint16_t height,
+                                    uint32_t buttons)
+{
+    AppleGFXState *s = d->state;
+
+    if (!s->dock_timer) {
+        return;
+    }
+    if (buttons || height < 2 || y < height - 1 ||
+        x < 16 || width <= 16 || x >= width - 16) {
+        timer_del(s->dock_timer);
+        s->dock_display = NULL;
+    } else if (s->dock_display != d) {
+        s->dock_display = d;
+        s->dock_pulses = 32;
+        timer_mod(s->dock_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 80);
+    }
+}
+
 static void apple_gfx_input_pointer(AppleGFXDisplay *d, uint16_t x,
                                     uint16_t y, uint16_t width,
                                     uint16_t height, uint32_t buttons)
@@ -368,6 +408,7 @@ static void apple_gfx_input_pointer(AppleGFXDisplay *d, uint16_t x,
     qemu_input_update_buttons(d->con, button_map, s->input_buttons, buttons);
     s->input_buttons = buttons;
     qemu_input_event_sync();
+    apple_gfx_dock_pressure(d, x, y, width, height, buttons);
 }
 
